  tests.test_ado_pr_intelligence_milestone_6_6 \
  tests.test_ado_sprint_intelligence_milestone_6_7 \
  tests.test_ado_agent_milestone_6_8 \
  tests.integration.test_ado_phase6_hardening \
  tests.integration.test_ado_phase6_operational_validation \
  tests.integration.test_ado_phase6_live \
