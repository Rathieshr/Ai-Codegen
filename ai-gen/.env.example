# ─────────────────────────────────────────────────────────────────────────────
# ai-gen backend environment variables
# Copy this file to .env and fill in your values.
# Never commit a .env file with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
AI_GEN_BACKEND_MODE=production          # local | production

# ── Authentication (Phase 1) ─────────────────────────────────────────────────
# Comma-separated API keys. Leave empty for open/dev mode (no auth).
# At least one key is required for production deployments.
AI_GEN_API_KEYS=your-secret-key-1,your-secret-key-2

# CORS origins. Use * for local dev, restrict for production.
# Example: https://dev.azure.com,https://yourapp.example.com
AI_GEN_CORS_ORIGINS=*

# Role enforcement. Set to 1 to block approvals from wrong roles.
# 0 = advisory only (logs a warning but allows through).
AI_GEN_ROLE_ENFORCEMENT=0

# ── Guardrails (Phase 1) ─────────────────────────────────────────────────────
# Maximum number of files a DEV stage may target before a scope-explosion
# warning is raised.
AI_GEN_GUARD_MAX_FILES=30

# ── Azure Phi Refinement (Phase 0) ───────────────────────────────────────────
AI_GEN_REFINER_ENABLED=1
AI_GEN_REFINER_PROVIDER=azure_phi
AI_GEN_REFINER_ENDPOINT=https://<your-foundry-endpoint>/models
AI_GEN_REFINER_API_KEY=<your-phi-api-key>
AI_GEN_REFINER_MODEL=Phi-4-mini-instruct
AI_GEN_REFINER_DEPLOYMENT=Phi-4-mini-instruct
AI_GEN_REFINER_API_VERSION=2024-05-01-preview
# Timeout tuning (Phase 0 defaults — usually safe to leave as-is)
AI_GEN_REFINER_TIMEOUT_SECONDS=20
AI_GEN_REFINER_CONNECT_TIMEOUT_SECONDS=5
AI_GEN_REFINER_PING_TIMEOUT_SECONDS=10
AI_GEN_REFINER_MAX_TOKENS=300
AI_GEN_REFINER_RESPONSE_FORMAT_ENABLED=1

# ── ADO Automation (Phase 3) ─────────────────────────────────────────────────
ADO_ORG_URL=https://dev.azure.com/your-org
ADO_PROJECT=YourProject
ADO_PAT=<personal-access-token>
# Required PAT scopes: Work Items (Read & Write), Code (Read & Write),
#                      Build (Read & Execute), Project and Team (Read)
ADO_DEFAULT_REPO_ID=<repo-guid>

# ── Paths ────────────────────────────────────────────────────────────────────
AI_GEN_PIPELINE_ROOT=.ai_gen_pipelines
AI_GEN_REPO_CONTEXT_ROOT=.ai_gen_repo_context
