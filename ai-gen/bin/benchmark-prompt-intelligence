#!/usr/bin/env python3
"""Generate the checked-in Prompt Intelligence benchmark report."""

from __future__ import annotations

import json
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from backend.prompt_intelligence_hardening import PromptIntelligenceHardeningHarness, render_benchmark_markdown


REPORT_ROOT = ROOT / "docs" / "testing"


def main() -> int:
    with tempfile.TemporaryDirectory() as temp:
        report = PromptIntelligenceHardeningHarness(Path(temp)).run()
    REPORT_ROOT.mkdir(parents=True, exist_ok=True)
    (REPORT_ROOT / "prompt-intelligence-benchmark.json").write_text(
        json.dumps(report, indent=2),
        encoding="utf-8",
    )
    (REPORT_ROOT / "prompt-intelligence-benchmark.md").write_text(
        render_benchmark_markdown(report),
        encoding="utf-8",
    )
    print(f"Prompt Intelligence readiness: {report['readiness']['status']}")
    return 0 if report["readiness"]["status"] == "Production Ready" else 1


if __name__ == "__main__":
    raise SystemExit(main())
